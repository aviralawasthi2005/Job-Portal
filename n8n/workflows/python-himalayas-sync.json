{
  "name": "Healthcare Job Portal - Python Strict Sync Scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "name": "Every 6 Hours Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PYTHON_SERVICE_URL || 'http://localhost:8000' }}/api/v1/jobs/sync?limit=150",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 3000
        }
      },
      "name": "Scrape & Filter Strictly with Python",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first()?.json || {};\nconst success = input.success === true;\nconst syncedJobs = input.totalValidHealthcareJobs || 0;\nconst totalFetched = input.totalFetchedFromHimalayas || 0;\n\nreturn [{\n  json: {\n    status: success ? 'SUCCESS' : 'FALLBACK',\n    syncedJobs,\n    totalFetched,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "name": "Process Sync Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_API_URL || 'http://localhost:3333' }}/api/v1/n8n/webhook-receive",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event\": \"cache.flush\",\n  \"data\": {\n    \"syncedJobs\": {{ $json.syncedJobs || 0 }},\n    \"status\": \"{{ $json.status }}\",\n    \"timestamp\": \"{{ $json.timestamp }}\"\n  }\n}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 2000
        }
      },
      "name": "Flush Backend Cache",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Every 6 Hours Schedule": {
      "main": [
        [
          {
            "node": "Scrape & Filter Strictly with Python",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scrape & Filter Strictly with Python": {
      "main": [
        [
          {
            "node": "Process Sync Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Sync Result": {
      "main": [
        [
          {
            "node": "Flush Backend Cache",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveDataErrorExecution": "all"
  }
}
