{
  "name": "Healthcare Job Portal - Candidate Application Intake & Python ATS",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "candidate-application",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Application Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "webhookId": "candidate-application-intake"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PYTHON_SERVICE_URL || 'http://localhost:8000' }}/api/v1/candidates/analyze-resume",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"application\": {{ JSON.stringify($json.body.application) }},\n  \"jobTitle\": {{ JSON.stringify($json.body.jobTitle || 'Healthcare Professional') }},\n  \"companyName\": {{ JSON.stringify($json.body.companyName || 'Healthcare Network') }}\n}",
        "options": {}
      },
      "name": "Analyze with Python Service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "applicantName",
              "value": "={{ $json.analysis.candidateName }}"
            },
            {
              "name": "applicantEmail",
              "value": "={{ $json.analysis.candidateEmail }}"
            },
            {
              "name": "targetJob",
              "value": "={{ $json.analysis.targetJob }}"
            },
            {
              "name": "licenseNumber",
              "value": "={{ $json.analysis.licenseNumber }}"
            },
            {
              "name": "licensedState",
              "value": "={{ $json.analysis.licensedState }}"
            },
            {
              "name": "qualificationScore",
              "value": "={{ $json.analysis.qualificationScore }}"
            },
            {
              "name": "recommendation",
              "value": "={{ $json.analysis.recommendation }}"
            },
            {
              "name": "resumeUrl",
              "value": "={{ $json.analysis.resumeUrl }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Extract Scored Applicant Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "careers@pulsehealthjobs.org",
        "toEmail": "={{ $json.applicantEmail }}",
        "subject": "=Application Confirmation: {{ $json.targetJob }}",
        "text": "=Dear {{ $json.applicantName }},\n\nThank you for applying for the position of {{ $json.targetJob }}.\n\nYour clinical credentials (License: {{ $json.licenseNumber }}, State: {{ $json.licensedState }}) have been analyzed and verified by our clinical screening engine.\nOur recruitment specialists are reviewing your profile (Status: {{ $json.recommendation }}).\n\nWarm regards,\nPulseCareers Healthcare Recruiting"
      },
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        880,
        220
      ]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL || 'https://httpbin.org/post' }}",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"text\": \"🩺 *New Healthcare Candidate Analyzed via Python Intelligence*\\n*Applicant:* {{ $json.applicantName }} ({{ $json.applicantEmail }})\\n*Role:* {{ $json.targetJob }}\\n*Score:* {{ $json.qualificationScore }}/100 ({{ $json.recommendation }})\\n*License:* {{ $json.licenseNumber }} (State: {{ $json.licensedState }})\\n*Resume:* {{ $json.resumeUrl }}\"\n}"
      },
      "name": "Notify Recruitment Slack Channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        880,
        380
      ]
    }
  ],
  "connections": {
    "Application Webhook Trigger": {
      "main": [
        [
          {
            "node": "Analyze with Python Service",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze with Python Service": {
      "main": [
        [
          {
            "node": "Extract Scored Applicant Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Scored Applicant Data": {
      "main": [
        [
          {
            "node": "Send Confirmation Email",
            "type": "main",
            "index": 0
          },
          {
            "node": "Notify Recruitment Slack Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
