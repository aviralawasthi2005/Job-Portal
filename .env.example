# ==============================================================================
# Healthcare Job Portal - Multi-Service Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global / Common
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Healthcare Job Portal"

# ------------------------------------------------------------------------------
# 2. AdonisJS Backend (backend-adonis)
# ------------------------------------------------------------------------------
ADONIS_PORT=3333
ADONIS_HOST=0.0.0.0
APP_KEY=your_adonis_secure_app_key_32_characters_here
LOG_LEVEL=info

# Database Connection (Lucid ORM / PostgreSQL)
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=healthcare_job_portal

# Redis Caching
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Express Proxy Backend (backend)
# ------------------------------------------------------------------------------
PORT=5000
FRONTEND_URL=http://localhost:5173
HIMALAYAS_API_URL=https://himalayas.app/jobs/api
CACHE_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# 4. SvelteJS Frontend (frontend-svelte)
# ------------------------------------------------------------------------------
VITE_ADONIS_API_URL=http://localhost:3333/api/v1
VITE_EXPRESS_API_URL=http://localhost:5000/api
VITE_APP_TITLE="PulseCareers | Healthcare Job Portal"
PORT_SVELTE=5174

# ------------------------------------------------------------------------------
# 5. React Frontend (frontend)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 6. Python Healthcare Intelligence (python-service)
# ------------------------------------------------------------------------------
PYTHON_PORT=8000
PYTHON_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 7. n8n Automation Engine (n8n)
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_AUTH_ENABLED=false
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=healthcare_secure_pass

# Webhook URLs triggered by Backend
N8N_WEBHOOK_NEW_JOB=http://localhost:5678/webhook/healthcare-new-job
N8N_WEBHOOK_APPLICATION=http://localhost:5678/webhook/candidate-application
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here

# External Integrations for n8n Workflows (Optional)
DISCORD_WEBHOOK_URL=https://your-discord-webhook-url
SLACK_WEBHOOK_URL=https://your-slack-incoming-webhook-url
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=recruiting@pulsehealthjobs.org
